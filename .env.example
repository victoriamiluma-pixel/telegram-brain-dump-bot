# ---- Telegram ----
# Get this from @BotFather on Telegram (see README Part 3).
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceThis

# Numeric Telegram user IDs allowed to use the bot, comma-separated (you + your boss).
# Leave this BLANK for the first run — the bot will reply to any message with
# the sender's ID so you can copy it in here, then restart the bot. Only
# these IDs will be allowed to use the bot.
TELEGRAM_ALLOWED_USER_IDS=

# ---- Groq (transcription + task extraction) ----
# Free, no credit card required. Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Notion ----
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=53a2f215cbb04a7e9a2a9a9e4ab255b3

# ---- Server ----
PORT=3000
